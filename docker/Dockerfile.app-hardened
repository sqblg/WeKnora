# Build only the patched WeKnora binary, then place it over the exact official
# v0.7.2 runtime image. This preserves the upstream runtime filesystem and
# keeps the security delta limited to the reviewed Go commit.
FROM golang:1.26-bookworm AS builder

WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/*

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY cmd/download cmd/download
RUN go run cmd/download/duckdb/duckdb.go
COPY . .

ARG VERSION_ARG
ARG COMMIT_ID_ARG
ARG BUILD_TIME_ARG
ARG GO_VERSION_ARG
ENV VERSION=${VERSION_ARG}
ENV COMMIT_ID=${COMMIT_ID_ARG}
ENV BUILD_TIME=${BUILD_TIME_ARG}
ENV GO_VERSION=${GO_VERSION_ARG}
RUN --mount=type=cache,target=/go/pkg/mod make build-prod

FROM wechatopenai/weknora-app@sha256:7cb9d5f25f626f82ec4b2369295313c5df0108757d28f4f18ada29337060025f
COPY --from=builder --chown=appuser:appuser /app/WeKnora /app/WeKnora
